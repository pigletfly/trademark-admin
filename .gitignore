# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage
/coverage

# Vitest artifacts (browser screenshots/attachments)
**/__screenshots__/
.vitest-attachments/

# Go binaries (belt-and-suspenders; apps/api/.gitignore also handles these)
apps/api/bin/
apps/api/server
apps/api/migrate
.claude

# Superpowers / feature worktrees
.worktrees/

# Some developers have a global `[Ll]ib` rule (Xcode convention) in
# ~/.gitignore that accidentally excludes our frontend's apps/web/src/lib/.
# Force-track it here so this repo is unaffected by that global rule.
!apps/web/src/lib/
!apps/web/src/lib/**

# The force-track above would accidentally re-include vitest failure
# screenshots under apps/web/src/lib/__screenshots__/. Re-ignore them
# explicitly (later rules win).
apps/web/src/lib/__screenshots__/
