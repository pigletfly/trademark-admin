{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["@playwright/test", "node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["fixtures/**/*", "tests/**/*", "playwright.config.ts"]
}
